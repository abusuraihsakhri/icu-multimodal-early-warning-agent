# Environment Configuration for ICU Multimodal Early Warning Agent
# Copy this file to .env and set your own secure values

# HMAC-SHA256 Audit Trail Secret Key (required)
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=your-secure-audit-key-here

# LLM Provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock
